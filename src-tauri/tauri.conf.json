{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gloss",
  "version": "0.1.0",
  "identifier": "com.meoki.gloss",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Gloss Settings",
        "url": "index.html",
        "width": 780,
        "height": 640,
        "minWidth": 640,
        "minHeight": 460,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "popup",
        "title": "Gloss",
        "url": "popup.html",
        "width": 420,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "meoki",
    "copyright": "Copyright (c) 2026 meoki",
    "category": "Productivity",
    "shortDescription": "Translate selected text from any app",
    "longDescription": "Select text in any app, press a hotkey, and Gloss shows an AI translation in a popup next to the cursor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
